{
  "name": "playwright-ts-enterprise-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable enterprise Playwright + TypeScript framework demonstrating the Seven Laws.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:orangehrm": "playwright test --project=orangehrm",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:shard": "playwright test --shard=$PLAYWRIGHT_SHARD_INDEX/$PLAYWRIGHT_SHARD_TOTAL",
    "test:ci": "node scripts/ci-env-check.js && playwright test",
    "flake:report": "npx tsx utilities/analytics/cli.ts --flake-report --since 7d --db ./analytics.db",
    "flake:insert": "npx tsx utilities/analytics/cli.ts --insert --report ./test-results/results.json --db ./analytics.db",
    "flake:slowest": "npx tsx utilities/analytics/cli.ts --slowest --limit 10 --db ./analytics.db",
    "capstone:c1": "cd ../challenges/solutions/CAP_C1 && npm test",
    "capstone:c2": "cd ../challenges/solutions/CAP_C2 && npm test",
    "capstone:c3:dev": "cd ../challenges/solutions/CAP_C3 && npm run dev",
    "report": "playwright show-report",
    "report:allure": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "merge-reports": "npx playwright merge-reports --reporter html ./playwright-report/ci-*",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.cjs --max-warnings=8",
    "lint:strict": "eslint . --ext .ts,.tsx,.js,.cjs --max-warnings=0",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.cjs --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "_comment_verify": "verify uses --max-warnings=8 baselined against current TS-boundary warnings (Zod/OTel/Playwright report-parser). Any NEW warning fails the build. lint:strict (=0) is the goal once those 8 are fixed.",
    "verify": "npm run lint && npm run typecheck",
    "prepare": "node -e \"try{require('child_process').execSync('npx husky',{cwd:require('path').resolve(__dirname,'..','..','..'),stdio:'ignore'})}catch(e){}\"",
    "test:docker": "docker compose -f docker-compose.yml run --rm playwright",
    "test:docker:build": "docker compose -f docker-compose.yml build"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@axe-core/playwright": "^4.10.1",
    "@opentelemetry/api": "^1.9.0",
    "allure-commandline": "^2.32.0",
    "allure-playwright": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-playwright": "^2.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "otplib": "^12.0.1",
    "prettier": "^3.4.0",
    "proper-lockfile": "^4.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
