# Copy this file to .env and fill in values. .env is gitignored.

# Environment identifier (local | dev | staging | prod)
ENV=local

# Base URLs — assembled into endpoints in constants/endpoints.ts
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
API_BASE_URL=https://reqres.in

# Feature flags
LOG_API_STEPS=true
HEADLESS=true

# Timeouts (override defaults if needed)
DEFAULT_TIMEOUT_MS=30000

# Account pool — for parallel safety demo
# Real credentials NEVER go here. Use a secrets manager in CI.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123
ORANGEHRM_DEMO_USERNAME=Admin
ORANGEHRM_DEMO_PASSWORD=admin123

# CI settings
CI=false
PLAYWRIGHT_WORKERS=4
PLAYWRIGHT_RETRIES=2
PLAYWRIGHT_SHARD_INDEX=
PLAYWRIGHT_SHARD_TOTAL=
