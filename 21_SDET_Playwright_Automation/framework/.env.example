# Copy this file to .env and fill in values. .env is gitignored.
# All keys are read by config/env.loader.ts (required keys fail fast at module load).

# ─── Environment ────────────────────────────────────────────────────────────
ENV=local                    # local | dev | staging | prod

# ─── Application base URLs (REQUIRED) ───────────────────────────────────────
# Assembled into endpoints in constants/endpoints.ts. Trailing slash auto-stripped.
ORANGEHRM_BASE_URL=https://opensource-demo.orangehrmlive.com
API_BASE_URL=https://reqres.in

# ─── reqres.in API key (optional; specs auto-skip without it) ───────────────
# reqres.in introduced mandatory auth in mid-2024. Get a free key at
# app.reqres.in/api-keys. Without this key, the users/resources/error-handling
# API specs auto-skip via `test.skip(!process.env.REQRES_API_KEY, ...)`.
REQRES_API_KEY=

# ─── Feature flags ──────────────────────────────────────────────────────────
LOG_API_STEPS=true           # Log each API request/response into the HTML report
LOG_ACTIONS=false            # Log each UI action (click/fill/select) to stdout

# ─── Browser / timeouts ─────────────────────────────────────────────────────
HEADLESS=true
DEFAULT_TIMEOUT_MS=30000     # Default for env-loader–driven utilities

# ─── Demo credentials for OrangeHRM (NEVER put real prod creds here) ────────
# OrangeHRM demo site uses Admin / admin123. Override per environment in CI secrets.
ORANGEHRM_DEMO_USERNAME=Admin
ORANGEHRM_DEMO_PASSWORD=admin123

# ─── Pooled-account demo (auth.fixture.ts) ──────────────────────────────────
# Real account pools live in CI secrets; these are demo defaults only.
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# ─── OAuth 2.0 client-credentials demo (auth.oauth.fixture.ts) ──────────────
# Leave blank if you don't run the OAuth demo specs. They fail fast at fixture load.
OAUTH_TOKEN_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPE=

# ─── CI / Playwright runner overrides ───────────────────────────────────────
CI=false
PLAYWRIGHT_WORKERS=4
PLAYWRIGHT_RETRIES=2

# Sharding — both pairs are supported. PLAYWRIGHT_SHARD_* takes precedence;
# SHARD_* is used by docker-compose.yml for symmetry with other tooling.
PLAYWRIGHT_SHARD_INDEX=
PLAYWRIGHT_SHARD_TOTAL=
SHARD_INDEX=
SHARD_TOTAL=
